# Скопируйте в .env. Пароль PostgreSQL: буквы и цифры, минимум 24 символа.
POSTGRES_PASSWORD=replace_with_a_random_password_24_chars

# Локальный режим; Docker Compose переопределяет эти три значения.
DATABASE_URL=sqlite:///./dus.db
TASK_MODE=local
REDIS_URL=redis://localhost:6379/0

# Оставьте пустыми для создания администратора при первом открытии.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
DEMO_MODE=false

YANDEX_API_KEY=
DGIS_API_KEY=
# Ключ Regions API для определения города. Если пусто, используется DGIS_API_KEY.
DGIS_REGIONS_API_KEY=
# Включать только при наличии соответствующих прав по договору поставщика.
YANDEX_ALLOW_STORAGE=false
YANDEX_ALLOW_EXPORT=false
DGIS_ALLOW_STORAGE=false
DGIS_ALLOW_EXPORT=false
# Контактные поля 2ГИС требуют отдельных прав ключа.
DGIS_CONTACTS_ENABLED=false
API_REQUEST_INTERVAL_SECONDS=1
